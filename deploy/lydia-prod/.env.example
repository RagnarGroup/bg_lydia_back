# ==============================================================================
# LYDIA -- INSTANCIA DE PRODUCCION (VPS Brittany Group, CRM-10/CRM-11)
# ==============================================================================
# NOTA: autogenerar todas las claves seguras con:
#       ./generate_secrets.sh
# Este archivo vive solo en el VPS como ".env" (600, root); nunca se commitea.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMINIOS (reverse proxy: Nginx + certbot en el host, no Traefik)
# ------------------------------------------------------------------------------
FRONTEND_DOMAIN=crm.brittanygroup.edu.pe
EVO_DOMAIN=api-crm.brittanygroup.edu.pe

# ------------------------------------------------------------------------------
# 2. POSTGRESQL 16 & REDIS 7 (contenedores propios de Lydia, no el MySQL/Redis
#    del host; esta stack queda aislada en su propia red Docker)
# ------------------------------------------------------------------------------
PG_DATABASE_USER=postgres
# Generar con: openssl rand -hex 18
PG_DATABASE_PASSWORD=reemplazar_por_password_seguro_sin_caracteres_conflictivos
PG_DATABASE_NAME=default

# Generar con: openssl rand -hex 18
REDIS_PASSWORD=reemplazar_por_password_seguro_redis

# ------------------------------------------------------------------------------
# 3. EVOLUTION API / WHATSAPP (lydia_bg_back)
# ------------------------------------------------------------------------------
# Clave maestra para acceder y controlar Evolution API (generar con: openssl rand -hex 24)
EVOLUTION_API_KEY=reemplazar_por_token_secreto_evolution

# Canal WhatsApp Cloud API (Meta). Token de verificacion del webhook
# (GET /webhook/meta): el mismo string va en Meta -> WhatsApp -> Configuracion
# -> Webhooks. Generar con: openssl rand -hex 24
WA_BUSINESS_TOKEN_WEBHOOK=reemplazar_por_token_verificacion_webhook_meta
# App Secret de la app de Meta (Configuracion de la app -> Basica -> Clave secreta).
# Con valor, POST /webhook/meta rechaza (401) todo lo que no venga firmado por Meta.
WA_BUSINESS_APP_SECRET=
# Version de Graph API y idioma por defecto de las plantillas.
WA_BUSINESS_VERSION=v23.0
WA_BUSINESS_LANGUAGE=es

# Canal TikTok (Business Messaging API). App ID y secret de la app "Lydia CRM - Brittany Group"
# en el portal de TikTok for Business. Sin APP_SECRET, POST /webhooks/tiktok rechaza todo (401).
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_API_VERSION=v1.3
# Cifra los tokens de TikTok en la base (AES-256-GCM). Generar con: openssl rand -hex 32
# No cambiarla despues de conectar cuentas: los tokens guardados dejarian de poder leerse.
TIKTOK_TOKEN_ENCRYPTION_KEY=

# Sidecar de conversion de audio (LYD-53), servicio `audio-converter` de este
# mismo docker-compose.yml -- convierte a mp3 las notas de voz grabadas en el
# navegador antes de subirlas a WhatsApp. Generar con: openssl rand -hex 24
API_AUDIO_CONVERTER_KEY=reemplazar_por_token_secreto_audio_converter

# ------------------------------------------------------------------------------
# 4. FRONTEND (lydia_bg_front) -- vacias hasta CRM-12
# ------------------------------------------------------------------------------
# Backend real de conversaciones/asignacion/notas (CRM-12). Hasta que exista,
# dejar en false/vacio: el frontend cae a datos de ejemplo en vez de romperse.
NEXT_PUBLIC_CHATWOOT_ENABLED=false
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 5. LOGIN (LYD-2, lydia_bg_front) -- requerido para que /api/auth/session
#    funcione (mapea el email de Google contra Agent.email via
#    GET /crm/leads, o mas bien /crm/agents), no depende de
#    NEXT_PUBLIC_LYDIA_API_ENABLED (eso solo gatea el inbox/pipeline/etc).
# ------------------------------------------------------------------------------
# URL interna de Evolution API dentro de la red lydia_internal_net (mismo
# alias que usa el service name en docker-compose.yml).
EVOLUTION_API_URL=http://evolution-api:8080
# Mismo valor que EVOLUTION_API_KEY de la seccion 3.
EVOLUTION_INSTANCE_NAME=

# CRM-9/CRM-11: sin numero de WhatsApp conectado todavia, dejar en false --
# el inbox/pipeline/etc siguen en datos de ejemplo hasta que haya uno.
NEXT_PUBLIC_LYDIA_API_ENABLED=false

# Mismo proyecto Firebase que sga_brittany_front (sga-brittany). Valores
# publicos del SDK web, no son secretos.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBbAMVjoU9rK50dnPhRASMFS6gefarBGvA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sga-brittany.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sga-brittany
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sga-brittany.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=485011705392
NEXT_PUBLIC_FIREBASE_APP_ID=1:485011705392:web:23425bd0de75b5830de7f5

# Firma la cookie de sesion propia de Lydia (jose/HMAC), NO es un secreto de
# Firebase. Generar con: openssl rand -base64 48
SESSION_SECRET=reemplazar_por_secreto_aleatorio_propio

# Token compartido con la landing (WordPress): header x-landing-token de POST /public/landing-leads.
# Sin valor ese endpoint responde 503. generate_secrets.sh lo genera.
LANDING_WEBHOOK_TOKEN=reemplazar_por_token_secreto_landing

# LYD-102: auditoria comercial diaria META K-01 (20:00 evalua, 21:00 envia).
# Destinatarios separados por coma. SMTP de Google Workspace: SMTP_USER es la
# cuenta que envia y SMTP_PASS una contrasena de aplicacion de esa cuenta
# (requiere verificacion en 2 pasos), nunca la contrasena normal.
COMMERCIAL_AUDIT_ENABLED=false
COMMERCIAL_AUDIT_TO=direccion@brittanygroup.edu.pe,desarrollo@brittanygroup.edu.pe
COMMERCIAL_AUDIT_ALERT_TO=desarrollo@brittanygroup.edu.pe
COMMERCIAL_AUDIT_FROM="Lydia - Auditoria comercial <lydia@brittanygroup.edu.pe>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lydia@brittanygroup.edu.pe
SMTP_PASS=reemplazar_por_contrasena_de_aplicacion
