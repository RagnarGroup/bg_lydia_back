# LYD-119: variables del entorno LOCAL de Lydia. Copiar a .env (git-ignorado)
# en esta misma carpeta. Son claves de juguete para la PC: los servicios solo
# escuchan en 127.0.0.1 y la base no tiene datos reales. Nunca reutilizar
# valores de /lydia_prod/.env aca.

PG_DATABASE_PASSWORD=lydia-local-pg
REDIS_PASSWORD=lydia-local-redis

# apikey global de Evolution API. La misma va en EVOLUTION_API_KEY del
# .env.local de lydia_bg_front.
EVOLUTION_API_KEY=lydia-local-apikey

API_AUDIO_CONVERTER_KEY=lydia-local-audio

# Webhook de Meta simulado (simulate-message.mjs firma con APP_SECRET).
WA_BUSINESS_TOKEN_WEBHOOK=lydia-local-verify
WA_BUSINESS_APP_SECRET=lydia-local-app-secret

# Opcional: para probar POST /public/landing-leads (header x-landing-token).
LANDING_WEBHOOK_TOKEN=lydia-local-landing
